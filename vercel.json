{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    },
    {
      "src": "login/**",
      "use": "@vercel/static"
    },
    {
      "src": "views/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/server.js"
    },
    {
      "src": "/login",
      "dest": "login/index.html"
    },
    {
      "src": "/dashboard",
      "dest": "views/dashboard.html"
    },
    {
      "src": "/(.*)",
      "dest": "public/$1"
    }
  ]
}